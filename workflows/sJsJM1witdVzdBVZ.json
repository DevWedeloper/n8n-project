    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst email = (item.json.Email || \"\").trim().toLowerCase();\nconst firstName = (item.json.Name?.first || \"\").trim();\nconst lastName = (item.json.Name?.last || \"\").trim();\nconst name = `${firstName} ${lastName}`.trim();\nconst company = (item.json.Company || \"\").trim();\nconst role = (item.json[\"Role / Title\"] || \"\").trim().toLowerCase();\nconst budget = Number(item.json.Budget) || 0;\nconst domain = email.split(\"@\")[1] || \"\";\n\nreturn {\n    json: {\n        email,\n        name,\n        company,\n        role,\n        budget,\n        domain\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        32
      ],
      "id": "6627ac1a-a5fa-4e99-96a1-d944549cd9f7",
      "name": "JS Normalization"
    },
    {
      "parameters": {
        "jsCode": "// Inputs from Zap\nconst budget = Number($('JS Normalization').first().json.budget) || 0;\nconst employeeCount = Number($input.first().json.employee_count) || 0;\nconst role = ($('JS Normalization').first().json.role || \"\").toLowerCase();\nconst industry = ($input.first().json.industry || \"\").toLowerCase();\n\n// Base score\nlet score = 0;\n\n// Budget contribution\nif (budget >= 10000) score += 40;\nelse if (budget >= 5000) score += 30;\nelse if (budget >= 1000) score += 20;\nelse score += 10;\n\n// Employee count contribution\nif (employeeCount > 5000) score += 30;\nelse if (employeeCount > 1000) score += 20;\nelse if (employeeCount > 100) score += 10;\n\n// Role contribution\nif (role.includes(\"manager\") || role.includes(\"director\") || role.includes(\"vp\")) score += 20;\nelse score += 10;\n\n// Industry boost\nif (industry.includes(\"software\") || industry.includes(\"tech\")) score += 10;\n\n// Clamp score 0-100\nif (score > 100) score = 100;\n\n// Assign band\nlet band = \"Low\";\nif (score >= 70) band = \"High\";\nelse if (score >= 40) band = \"Medium\";\n\nreturn {\n  json: {\n    score,\n    band,\n    employeeCount: ($input.first().json.employee_count || 0),\n    industry: ($input.first().json.industry || \"\")\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        32
      ],
      "id": "11dead7e-027e-4f80-a38e-b5f5abfe5039",
      "name": "Scoring"
    },

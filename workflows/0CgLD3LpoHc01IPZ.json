      ],
      "id": "2135b1fd-844a-4519-8cf2-f7ba7b31ae2e",
      "name": "Convert to File"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\n\n// Convert current time to GMT+8\nconst gmt8Time = new Date(now.getTime() + (8 - now.getTimezoneOffset() / 60) * 60 * 60 * 1000);\n\nconst formatted =\n  gmt8Time.getUTCFullYear() + '-' +\n  String(gmt8Time.getUTCMonth() + 1).padStart(2, '0') + '-' +\n  String(gmt8Time.getUTCDate()).padStart(2, '0') + ' ' +\n  String(gmt8Time.getUTCHours()).padStart(2, '0') + ':' +\n  String(gmt8Time.getUTCMinutes()).padStart(2, '0');\n\nreturn items.map(item => {\n  return {\n    json: {\n      ...item.json,\n      date: formatted\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "89447d48-e186-4ecb-b7c5-f09641b2f5e9",
      "name": "Sanitize"
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"filename\": \"example.md\",\n  \"title\": \"My Markdown File\",\n  \"author\": \"John Doe\",\n  \"date\": \"{{ $now.toISOString() }}\",\n  \"content\": \"This is the main content of the markdown file.\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        0
      ],
      "id": "1317f949-06a3-4e04-acf6-ba1e2725dc27",
      "name": "Set Dummy Data"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst frontMatter = `---\ntitle: \"${data.title}\"\nauthor: \"${data.author}\"\ndate: \"${data.date}\"\n---\n\n`;\n\nconst markdownContent = frontMatter + data.content;\n\nreturn [\n  {\n    json: {\n      filename: data.filename,\n      fileContent: markdownContent,\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
